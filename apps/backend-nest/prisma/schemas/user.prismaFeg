/**
 * 用户模块数据模型
 * 
 * 此文件定义了用户相关的数据模型，包括：
 * - 用户基本信息
 * - 用户认证信息
 * - 用户权限和状态
 */

/**
 * 用户数据模型
 * 
 * 定义系统中用户的基本信息和属性
 * 包含用户认证、授权和基本资料信息
 */
model User {
  /// 用户唯一标识符，自动递增的主键
  id        Int      @id @default(autoincrement())
  
  /// 用户名，必须唯一，用于登录认证
  username  String   @unique
  
  /// 用户邮箱地址，必须唯一，可用于找回密码等功能
  email     String   @unique
  
  /// 用户密码，存储加密后的密码哈希值
  password  String
  
  /// 用户头像 URL，可选字段，用于显示用户头像
  avatar    String?
  
  /// 用户账户状态，默认为激活状态
  /// true: 账户激活，可正常使用
  /// false: 账户禁用，无法登录
  isActive  Boolean  @default(true)
  
  /// 用户角色信息，以 JSON 字符串形式存储角色数组
  /// 例如: "user", "admin", "moderator" 等
  /// 默认为普通用户角色
  roles     String   @default("user")
  
  /// 用户创建时间，自动设置为当前时间
  createdAt DateTime @default(now())
  
  /// 用户信息最后更新时间，每次更新时自动更新
  updatedAt DateTime @updatedAt

  /// 映射到数据库表名 "users"
  @@map("users")
}