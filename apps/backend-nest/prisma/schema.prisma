/**
 * Prisma 数据库模式定义文件
 * 
 * 此文件定义了应用程序的数据库结构，包括：
 * - 数据库连接配置
 * - 数据模型定义
 * - 字段类型和约束
 * - 索引和关系映射
 * 
 * 更多信息请参考: https://pris.ly/d/prisma-schema
 */

/**
 * Prisma 客户端生成器配置
 * 
 * 生成 TypeScript 类型安全的数据库客户端
 * 生成的客户端将包含所有模型的 CRUD 操作方法
 */
generator client {
  provider = "prisma-client-js"
}

/**
 * 数据源配置
 * 
 * 使用 SQLite 作为数据库提供者
 * 数据库连接 URL 从环境变量 DATABASE_URL 中读取
 * SQLite 适合开发和小型应用，数据存储在本地文件中
 */
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * 用户数据模型
 * 
 * 定义系统中用户的基本信息和属性
 * 包含用户认证、授权和基本资料信息
 */
model User {
  /// 用户唯一标识符，自动递增的主键
  id        Int      @id @default(autoincrement())
  
  /// 用户名，必须唯一，用于登录认证
  username  String   @unique
  
  /// 用户邮箱地址，必须唯一，可用于找回密码等功能
  email     String   @unique
  
  /// 用户密码，存储加密后的密码哈希值
  password  String
  
  /// 用户头像 URL，可选字段，用于显示用户头像
  avatar    String?
  
  /// 用户账户状态，默认为激活状态
  /// true: 账户激活，可正常使用
  /// false: 账户禁用，无法登录
  isActive  Boolean  @default(true)
  
  /// 用户角色信息，以 JSON 字符串形式存储角色数组
  /// 例如: "user", "admin", "moderator" 等
  /// 默认为普通用户角色
  roles     String   @default("user")
  
  /// 用户创建时间，自动设置为当前时间
  createdAt DateTime @default(now())
  
  /// 用户信息最后更新时间，每次更新时自动更新
  updatedAt DateTime @updatedAt

  /// 映射到数据库表名 "users"
  @@map("users")
}