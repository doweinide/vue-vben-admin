/**
 * 用户模块数据模型
 * 
 * 此文件定义了用户相关的数据模型，包括：
 * - 用户基本信息
 * - 用户认证信息
 * - 用户权限和状态
 * - 用户角色多对多关联
 */

/**
 * 用户数据模型
 * 
 * 定义系统中用户的基本信息和属性
 * 包含用户认证、授权和基本资料信息
 * 支持部门关联和多角色关联
 */
model User {
  /// 用户唯一标识符，使用 CUID 作为主键
  id        String   @id @default(cuid())
  
  /// 用户名，必须唯一，用于登录认证
  username  String   @unique @db.VarChar(50)
  
  /// 用户邮箱地址，必须唯一，可用于找回密码等功能
  email     String   @unique @db.VarChar(100)
  
  /// 用户密码，存储加密后的密码哈希值
  password  String   @db.VarChar(255)
  
  /// 用户真实姓名
  name      String?  @db.VarChar(50)
  
  /// 用户头像 URL，可选字段，用于显示用户头像
  avatar    String?  @db.VarChar(500)
  
  /// 所属部门ID
  deptId    String?  @map("dept_id")
  
  /// 用户账户状态：0-禁用，1-启用
  status    Int      @default(1) @db.SmallInt
  
  /// 用户创建时间，自动设置为当前时间
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  
  /// 用户信息最后更新时间，每次更新时自动更新
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 关系定义
  /// 所属部门
  department Department? @relation(fields: [deptId], references: [id], onDelete: SetNull)
  
  /// 用户角色关联（多对多）
  userRoles  UserRole[]

  // 索引定义
  @@index([deptId], map: "idx_users_dept_id")
  @@index([status], map: "idx_users_status")
  @@index([createdAt(sort: Desc)], map: "idx_users_created_at")
  /// 映射到数据库表名 "users"
  @@map("users")
}

/**
 * 用户角色关联表
 *
 * 多对多关系：用户 <-> 角色
 * 支持一个用户拥有多个角色，一个角色可以分配给多个用户
 */
model UserRole {
  /// 关联记录唯一标识
  id String @id @default(cuid())
  
  /// 用户ID
  userId String @map("user_id")
  
  /// 角色ID
  roleId String @map("role_id")
  
  /// 分配时间
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  
  /// 分配者ID（可选，记录是谁分配的角色）
  assignedBy String? @map("assigned_by")
  
  // 关系定义
  /// 关联的用户
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  /// 关联的角色
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  // 复合唯一约束：同一用户不能重复分配同一角色
  @@unique([userId, roleId], map: "uk_user_role")
  @@index([userId], map: "idx_user_roles_user_id")
  @@index([roleId], map: "idx_user_roles_role_id")
  @@index([assignedAt(sort: Desc)], map: "idx_user_roles_assigned_at")
  @@map("user_roles")
}